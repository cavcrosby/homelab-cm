---
{#
  Manifest that deploys the aptly-api onto Kubernetes.
#}
apiVersion: v1
kind: ConfigMap
metadata:
  name: aptly-conf
  namespace: {{ namespace_ }}
data:
  aptly.conf: |
    {
      "rootDir": "/var/lib/aptly-api",
      "FileSystemPublishEndpoints": {
        "debs": {
          "rootDir": "/mnt",
          "linkMethod": "copy"
        }
      }
    }

---
apiVersion: v1
kind: Secret
metadata:
  name: gpg-keys
  namespace: {{ namespace_ }}
data:
  aptly-any.gpg: {{ encoded_aptly_gpg_key_any }}
  aptly-trixie.gpg: {{ encoded_aptly_gpg_key_trixie }}

---
apiVersion: v1
kind: Secret
type: kubernetes.io/dockerconfigjson
metadata:
  name: dockerhub-creds
  namespace: {{ namespace_ }}
data:
  .dockerconfigjson: {{ encoded_dockerhub_config }}

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: {{ namespace_ }}
imagePullSecrets:
  - name: dockerhub-creds

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ namespace_ }}-aptly-api
spec:
  capacity:
    storage: {{ nfs_export_size_aptly_api }}
  accessModes:
    - ReadWriteMany
  nfs:
    server: {{ nfs_export_aptly_api.host }}
    path: {{ nfs_export_aptly_api.device }}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: aptly-api
  namespace: {{ namespace_ }}
spec:
  volumeName: {{ namespace_ }}-aptly-api
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: {{ nfs_export_size_aptly_api }}

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ namespace_ }}-debs
spec:
  capacity:
    storage: {{ nfs_export_size_debs }}
  accessModes:
    - ReadWriteMany
  nfs:
    server: {{ nfs_export_debs.host }}
    path: {{ nfs_export_debs.device }}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: debs
  namespace: {{ namespace_ }}
spec:
  volumeName: {{ namespace_ }}-debs
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: {{ nfs_export_size_debs }}

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ namespace_ }}-caddy
spec:
  capacity:
    storage: {{ nfs_export_size_caddy }}
  accessModes:
    - ReadWriteMany
  nfs:
    server: {{ nfs_export_caddy.host }}
    path: {{ nfs_export_caddy.device }}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: caddy
  namespace: {{ namespace_ }}
spec:
  volumeName: {{ namespace_ }}-caddy
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: {{ nfs_export_size_caddy }}

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ namespace_ }}-debs-ro
spec:
  capacity:
    storage: {{ nfs_export_size_debs }}
  accessModes:
    - ReadOnlyMany
  nfs:
    server: {{ nfs_export_debs.host }}
    path: {{ nfs_export_debs.device }}

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: debs-ro
  namespace: {{ namespace_ }}
spec:
  volumeName: {{ namespace_ }}-debs-ro
  accessModes:
    - ReadOnlyMany
  resources:
    requests:
      storage: {{ nfs_export_size_debs }}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: aptly-api
  namespace: {{ namespace_ }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: aptly-api
  template:
    metadata:
      labels:
        app.kubernetes.io/name: aptly-api
    spec:
      containers:
        - name: aptly-api
          image: cavcrosby/aptly-api:{{ aptly_api_image_version }}
          env:
            - name: PORT
              value: "80"
            - name: CONFIG_PATH
              value: /etc/aptly-api/aptly.conf
          readinessProbe:
            httpGet:
              path: /api/ready
              port: 80
          livenessProbe:
            httpGet:
              path: /api/healthy
              port: 80
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 25m
              memory: 50Mi
          volumeMounts:
            - name: aptly-api
              mountPath: /var/lib/aptly-api
            - name: debs
              mountPath: /mnt
            - name: conf
              mountPath: /etc/aptly-api
            - name: gpg-keys
              mountPath: /etc/aptly-api/secrets/gpg
      volumes:
        - name: aptly-api
          persistentVolumeClaim:
            claimName: aptly-api
        - name: debs
          persistentVolumeClaim:
            claimName: debs
        - name: conf
          configMap:
            name: aptly-conf
        - name: gpg-keys
          secret:
            secretName: gpg-keys

---
apiVersion: v1
kind: Service
metadata:
  name: aptly-api
  namespace: {{ namespace_ }}
spec:
  selector:
    app.kubernetes.io/name: aptly-api
  ports:
    - name: http
      port: 80
      targetPort: 80

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: aptly-api
  namespace: {{ namespace_ }}
spec:
  parentRefs:
    - name: {{ gateway_name }}
      namespace: {{ gateway_namespace }}
  hostnames:
    - aptly-api.{{ homelab_network_domain }}
  rules:
    - matches:
      - path:
          type: PathPrefix
          value: /
      backendRefs:
        - name: aptly-api
          port: 80

---
apiVersion: gateway.nginx.org/v1alpha1
kind: ClientSettingsPolicy
metadata:
  name: aptly-api
  namespace: {{ namespace_ }}
spec:
  targetRef:
    group: gateway.networking.k8s.io
    kind: HTTPRoute
    name: aptly-api
  body:
    maxSize: "0" # disables checking size

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: caddy
  namespace: {{ namespace_ }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: caddy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: caddy
    spec:
      containers:
        - name: caddy
          image: cavcrosby/caddy:{{ caddy_image_version }}
          command:
           - caddy
           - file-server
           - --browse
           - --root
           - /srv/http/debs
          readinessProbe:
            httpGet:
              path: /
              port: 80
          livenessProbe:
            httpGet:
              path: /
              port: 80
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: 5m
              memory: 10Mi
          volumeMounts:
            - name: caddy
              mountPath: /data
            - name: debs
              mountPath: /srv/http/debs
      volumes:
        - name: caddy
          persistentVolumeClaim:
            claimName: caddy
        - name: debs
          persistentVolumeClaim:
            claimName: debs-ro

---
apiVersion: v1
kind: Service
metadata:
  name: caddy
  namespace: {{ namespace_ }}
spec:
  selector:
    app.kubernetes.io/name: caddy
  ports:
    - name: http
      port: 80
      targetPort: 80

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: caddy
  namespace: {{ namespace_ }}
spec:
  parentRefs:
    - name: {{ gateway_name }}
      namespace: {{ gateway_namespace }}
  hostnames:
    - apt.{{ homelab_network_domain }}
  rules:
    - matches:
      - path:
          type: PathPrefix
          value: /
      backendRefs:
        - name: caddy
          port: 80
